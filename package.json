{
  "name": "gangoy-videos",
  "version": "0.1.0",
  "description": "Gangoy Vídeos: gerador local de histórias em vídeo para o YouTube",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n servidor,interface \"tsx watch src/servidor/servidor.ts --desenvolvimento\" \"vite --config interface/vite.config.ts\"",
    "construir:interface": "vite build --config interface/vite.config.ts",
    "iniciar": "npm run construir:interface && tsx src/servidor/servidor.ts",
    "verificar": "tsc --noEmit && vue-tsc --noEmit -p interface/tsconfig.json",
    "test": "node --import tsx --test \"testes/servidor/**/*.test.ts\"",
    "teste:interface": "playwright test",
    "teste:ollama": "tsx scripts/testeOllama.ts",
    "ui:adicionar": "tsx scripts/adicionarComponenteUi.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@lucide/vue": "^1.52.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.5",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
